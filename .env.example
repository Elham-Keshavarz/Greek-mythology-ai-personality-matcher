# Mythology retrieval (Sentence Transformers + FAISS) works without API credentials.
# Configure BOTH values only if you want hosted LLM-generated answers.
# Your provider may bill separately for API calls.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: only for an OpenAI-compatible provider / gateway.
# OPENAI_BASE_URL=https://your-provider.example/v1

# IMPORTANT: .env is gitignored. Never commit or share real API credentials.
